{
  "name": "@liuling/sz-ui",
  "version": "0.1.0",
  "description": "A lightweight React UI component library built with TypeScript, webpack, and milligram.",
  "author": "",
  "license": "MIT",
  "homepage": "https://sz-ui-indol.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuling/sz-ui.git"
  },
  "bugs": {
    "url": "https://github.com/liuling/sz-ui/issues"
  },
  "keywords": [
    "react",
    "typescript",
    "component-library",
    "modal",
    "milligram",
    "webpack"
  ],
  "main": "dist/sz-ui.cjs.js",
  "module": "dist/sz-ui.esm.js",
  "types": "dist/types/index.d.ts",
  "style": "dist/style.css",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css",
    "dist/*.css"
  ],
  "scripts": {
    "clean": "rimraf dist dist-docs .vercel-output",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "build:types": "tsc -p tsconfig.build.json",
    "build:lib": "rimraf dist && webpack --config webpack.lib.js --mode production",
    "build:docs": "webpack --config webpack.docs.js --mode production",
    "build": "npm run clean && npm run lint && npm run typecheck && npm run build:lib && npm run build:types && npm run build:docs",
    "dev": "npm run build:docs && serve dist-docs -l 3000",
    "preview": "serve dist-docs -l 3000",
    "release:patch": "npm version patch && npm run build && npm publish --access public",
    "release:minor": "npm version minor && npm run build && npm publish --access public",
    "release:major": "npm version major && npm run build && npm publish --access public"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "milligram": "^1.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "caniuse-lite": "^1.0.30001793",
    "css-loader": "^7.1.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "html-webpack-plugin": "^5.6.5",
    "mini-css-extract-plugin": "^2.9.4",
    "rimraf": "^6.1.2",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "webpack": "^5.103.0",
    "serve": "^14.2.5",
    "webpack-cli": "^6.0.1"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
